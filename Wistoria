        <button class="menu-button"
                id="openMenu"
                aria-label="Open navigation"
                aria-expanded="false">
            🍙
        </button>
    </nav>
</header>

<!-- SIDEBAR -->

<div class="overlay" id="overlay"></div>

<nav class="side-menu" id="sideMenu" aria-hidden="true">

