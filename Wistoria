</nav>

<!-- HERO -->

<section class="hero" id="home">
    <div class="hero-content">

        <span class="hero-tag">
            ❄ THE WORLD OF MAGIC AND SWORDS
        </span>

        <h1>Discover the World of Wistoria.</h1>

        <p>
            Explore the characters, personalities, abilities,
            and relationships behind Wistoria: Wand and Sword.
        </p>

        <a href="#character" class="hero-button">
            Explore Characters →
        </a>

    </div>
</section>

<!-- MAIN -->

<main class="container">

    <div class="section-heading">
        <small>CHARACTER ENCYCLOPEDIA</small>
        <h2>Character Archives</h2>
    </div>

    <!-- SEARCH -->

    <div class="search-wrapper">
        <div class="search-box">
            <span>🔍</span>
            <input type="text"
                   id="searchInput"
                   placeholder="Search character information..."
