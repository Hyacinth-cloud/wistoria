
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wisteria | Wand and Sword</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --blue: #2389ee;
    --dark-blue: #0755a5;
    --light-blue: #eaf5ff;
    --white: #ffffff;
    --text: #27394d;
    --muted: #71849a;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--light-blue);
    color: var(--text);
    line-height: 1.7;
}



header {
    background: white;
    border-bottom: 1px solid #d5e9fc;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 15px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 19px;
    font-weight: 800;
    color: var(--dark-blue);
    letter-spacing: 1px;
}

.logo span {
    color: var(--blue);
}

.menu-button {
    background: var(--blue);
    color: white;
    border: none;
    border-radius: 12px;
    width: 43px;
    height: 43px;
    font-size: 21px;
    cursor: pointer;
}



.overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 20, 50, 0.55);
    opacity: 0;
    visibility: hidden;
    transition: 0.3s;
    z-index: 2000;
}

.overlay.active {
    opacity: 1;
    visibility: visible;
}

.side-menu {
    position: fixed;
    top: 0;
    right: 0;
    width: 290px;
    max-width: 85%;
    height: 100vh;
    height: 100dvh;
    background: white;
    padding: 25px 20px;
    box-shadow: -5px 0 25px rgba(0,0,0,0.15);
    z-index: 2001;
    transform: translateX(110%);
    visibility: hidden;
    transition: transform 0.35s ease, visibility 0.35s ease;
    overflow-y: auto;
}

.side-menu.active {
    transform: translateX(0);
    visibility: visible;
}

.menu-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.menu-top h2 {
    color: var(--dark-blue);
    font-size: 20px;
}

.close-menu {
    border: none;
    background: var(--light-blue);
    color: var(--dark-blue);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-size: 18px;
    cursor: pointer;
}

.menu-label {
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    margin: 25px 15px 10px;
}

.side-menu a {
    display: block;
    padding: 13px 15px;
    margin-bottom: 8px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    font-size: 14px;
    transition: 0.2s;
}

.side-menu a:hover {
    background: var(--light-blue);
    color: var(--blue);
}



.hero {
    background:
        radial-gradient(circle at 85% 20%, #a6d9ff 0, transparent 30%),
        linear-gradient(120deg, #0b66c3, #329af2, #80caff);
    color: white;
    padding: 75px 25px;
}

.hero-content {
    max-width: 1150px;
    margin: auto;
}

.hero-tag {
    display: inline-block;
    background: rgba(255,255,255,0.18);
    padding: 7px 16px;
    border-radius: 30px;
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(32px, 6vw, 55px);
    line-height: 1.2;
    max-width: 650px;
    font-weight: 800;
    margin-bottom: 18px;
}

.hero p {
    max-width: 530px;
    font-size: 14px;
    color: #edf7ff;
    margin-bottom: 25px;
}

.hero-button {
    display: inline-block;
    background: white;
    color: var(--dark-blue);
    padding: 12px 25px;
    border-radius: 30px;
    font-weight: 600;
    text-decoration: none;
    font-size: 13px;
    transition: 0.3s;
}

.hero-button:hover {
    transform: translateY(-3px);
}



.container {
    max-width: 1150px;
    padding: 45px 25px;
    margin: auto;
}

.section-heading {
    margin-bottom: 25px;
}

.section-heading small {
    color: var(--blue);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

.section-heading h2 {
    color: var(--dark-blue);
    font-size: 27px;
    margin-top: 5px;
}



.search-wrapper {
    margin-bottom: 35px;
}

.search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    background: white;
    padding: 13px 18px;
    border: 1px solid #d4e8fc;
    border-radius: 14px;
    max-width: 600px;
}

.search-box input {
    border: none;
    outline: none;
    width: 100%;
    font-family: inherit;
    font-size: 13px;
}



.profile-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 30px;
    align-items: start;
}

.profile-main {
    min-width: 0;
}

.character-title {
    margin-bottom: 25px;
}

.character-title small {
    color: var(--blue);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

.character-title h1 {
    font-size: 35px;
    color: var(--dark-blue);
    line-height: 1.3;
    margin-top: 8px;
}

.character-title p {
    color: var(--muted);
    font-size: 13px;
    margin-top: 8px;
}



.info-card {
    background: white;
    padding: 18px;
    border-radius: 18px;
    box-shadow: 0 5px 25px rgba(33, 105, 169, 0.09);
    border: 1px solid #d9ebfc;
    position: sticky;
    top: 100px;
}

.info-card img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    border-radius: 12px;
}

.info-card h2 {
    color: var(--dark-blue);
    font-size: 19px;
    text-align: center;
    margin: 15px 0 20px;
}

.info-item {
    padding: 12px 0;
    border-top: 1px solid #e8f1fa;
}

.info-item small {
    display: block;
    color: var(--blue);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.info-item p {
    font-size: 13px;
    margin-top: 3px;
}



.content-section {
    background: white;
    padding: 25px;
    border-radius: 16px;
    margin-bottom: 22px;
    border: 1px solid #dcecfb;
    box-shadow: 0 4px 15px rgba(33, 105, 169, 0.04);
    scroll-margin-top: 100px;
}

.content-section h2 {
    color: var(--dark-blue);
    font-size: 21px;
    margin-bottom: 15px;
}

.content-section h2 span {
    background: #e6f3ff;
    padding: 8px;
    border-radius: 10px;
    font-size: 17px;
}

.content-section p {
    font-size: 13px;
    line-height: 2;
    color: #46576a;
    text-align: justify;
    margin-bottom: 15px;
}

.content-section p:last-child {
    margin-bottom: 0;
}



.relationship-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.relationship-card {
    background: #edf6ff;
    padding: 17px;
    border-radius: 12px;
    border: 1px solid #d7eaff;
}

.relationship-card small {
    display: block;
    font-size: 10px;
    color: var(--blue);
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.relationship-card strong {
    display: block;
    font-size: 14px;
    color: var(--dark-blue);
    margin-top: 5px;
}



.search-message {
    display: none;
    color: var(--dark-blue);
    background: white;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    font-size: 13px;
    margin-bottom: 20px;
}



footer {
    background: #0755a5;
    color: white;
    padding: 35px 20px;
    text-align: center;
}

footer h2 {
    font-size: 18px;
    margin-bottom: 8px;
}

footer p {
    font-size: 11px;
    color: #d6eaff;
}

.footer-line {
    width: 50px;
    height: 3px;
    background: #83c7ff;
    margin: 15px auto;
    border-radius: 10px;
}



@media (max-width: 800px) {
    .profile-layout {
        grid-template-columns: 1fr;
    }

    .info-card {
        position: static;
        max-width: 500px;
        width: 100%;
        margin: 0 auto 10px;
    }

    .info-card img {
        height: 260px;
    }
}

@media (max-width: 500px) {
    .navbar {
        padding: 12px 16px;
    }

    .logo {
        font-size: 14px;
    }

    .hero {
        padding: 60px 22px;
    }

    .hero h1 {
        font-size: 34px;
    }

    .container {
        padding: 30px 16px;
    }

    .character-title h1 {
        font-size: 29px;
    }

    .section-heading h2 {
        font-size: 23px;
    }

    .content-section {
        padding: 20px 17px;
    }

    .relationship-grid {
        grid-template-columns: 1fr;
    }
}

</style>
</head>

<body>

