                <p>Elfaria Albis Serfort</p>
            </div>

            <div class="info-item">
                <small>Origin</small>
                <p>Sefort Orphanage</p>
            </div>

            <div class="info-item">
                <small>Abilities</small>
                <p>Ice Magic (氷魔法)</p>
            </div>

            <div class="info-item">
                <small>Position</small>
                <p>One of the Magia Vander</p>
            </div>

        </aside>

    </div>

</main>

